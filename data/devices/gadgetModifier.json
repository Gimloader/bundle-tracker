                    "props": {
                        "options": [
                            {
                                "value": true,
                                "name": "Yes"
                            },
                            {
                                "value": false,
                                "name": "No"
                            }
                        ],
                        "allowEmpty": false
                    }
                }
            },
            {
                "key": "damage",
                "option": {
                    "label": "Damage",
                    "description": "Damage of the item",
                    "type": "numberInput",
                    "defaultValue": 100,
                    "validators": [
                        null
                    ],
                    "props": {
                        "min": 0,
                        "max": 999999999,
                        "step": 1,
                        "allowEmpty": false,
                        "useSlider": false
                    },
                    "hideIf": [
                        [
                            {
                                "key": "modifyDamage",
                                "compare": "NOT_EQUAL",
                                "value": true
                            }
                        ]
                    ]
                }
            },
            {
                "key": "modifyDistance",
                "option": {
                    "label": "Modify Distance",
                    "type": "select",
