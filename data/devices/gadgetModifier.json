                            },
                            {
                                "value": false,
                                "name": "No"
                            }
                        ],
                        "allowEmpty": false
                    }
                }
            },
            {
                "key": "distance",
                "option": {
                    "label": "Distance",
                    "description": "Distance of the item",
                    "type": "numberInput",
