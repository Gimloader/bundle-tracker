            {
                "key": "modifySpeed",
                "option": {
                    "label": "Modify Speed",
                    "type": "select",
                    "description": "Modify Speed of the item",
                    "defaultValue": false,
                    "validators": [
                        null
                    ],
                    "props": {
                        "options": [
                            {
                                "value": true,
                                "name": "Yes"
                            },
                            {
                                "value": false,
                                "name": "No"
                            }
                        ],
                        "allowEmpty": false
                    }
                }
            },
            {
                "key": "speed",
                "option": {
                    "label": "Speed",
                    "description": "Speed of the item",
                    "type": "numberInput",
                    "defaultValue": 100,
                    "validators": [
