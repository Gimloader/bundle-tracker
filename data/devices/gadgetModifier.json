                            },
                            {
                                "value": false,
                                "name": "No"
                            }
                        ],
                        "allowEmpty": false
                    }
                }
            },
            {
                "key": "clipSize",
                "option": {
                    "label": "Clip Size",
                    "description": "Clip size of the item",
                    "type": "numberInput",
                    "defaultValue": 100,
                    "validators": [
                        null
