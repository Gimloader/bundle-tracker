    },
    "defaultState": {},
    "codeGridSchema": {
        "allowChannelGrids": false,
        "triggers": [],
        "customBlocks": []
    },
    "wireConfig": {
        "in": {
            "connections": [
                {
                    "id": "activate",
                    "name": "Activate class"
                },
                {
                    "id": "deactivate",
                    "name": "Deactivate class"
                }
            ]
