                    "description": "When a player hits a dynamic building, should it be damaged?",
                    "type": "select",
                    "validators": [
                        null
                    ],
                    "defaultValue": 1,
                    "props": {
                        "options": [
                            {
                                "value": 1,
                                "name": "Do Not Override"
                            },
                            {
                                "value": 2,
                                "name": "Yes"
                            },
                            {
                                "value": 3,
                                "name": "No"
                            }
                        ],
                        "allowEmpty": false
