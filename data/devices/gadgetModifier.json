{
    "id": "gadgetModifier",
    "name": "Gadget Modifier",
    "description": "Modify gadget properties.",
    "optionSchema": {
        "options": [
            {
                "key": "itemId",
                "option": {
                    "label": "Item ID",
                    "description": "ID of the item to use",
                    "type": "itemId",
                    "validators": [
                        null
                    ],
                    "props": {
                        "allowedItemsCategories": [
                            "weapon"
                        ]
                    }
                }
            },
            {
                "key": "activateChannel",
                "option": {
                    "label": "Activate class when receiving on",
                    "type": "textInput",
                    "defaultValue": "",
                    "validators": [
                        null
                    ],
                    "props": {
                        "placeholder": "Channel name...",
                        "category": "channel",
                        "maxLength": 100
                    },
                    "description": "Activate class for triggering character when the device receives a signal from the selected channel"
                }
            },
            {
                "key": "deactivateChannel",
                "option": {
                    "label": "Deactivate class when receiving on",
                    "type": "textInput",
                    "defaultValue": "",
                    "validators": [
                        null
                    ],
                    "props": {
                        "placeholder": "Channel name...",
                        "category": "channel",
                        "maxLength": 100
                    },
                    "description": "Deactivate class for triggering character when the device receives a signal from the selected channel"
                }
            },
            {
                "key": "scope",
                "option": {
                    "label": "Scope",
                    "type": "select",
                    "defaultValue": "global",
                    "validators": [
                        null
                    ],
                    "props": {
                        "options": [
                            {
                                "value": "global",
                                "name": "global"
                            },
                            {
                                "value": "player",
                                "name": "player"
                            },
                            {
                                "value": "team",
                                "name": "team"
                            }
                        ],
                        "allowEmpty": false
                    },
                    "description": "Scope of the class"
                }
            },
            {
                "key": "modifyDurability",
                "option": {
                    "label": "Modify Durability",
                    "type": "select",
                    "description": "Modify Durability of the item",
                    "defaultValue": false,
                    "validators": [
                        null
                    ],
                    "props": {
                        "options": [
                            {
                                "value": true,
                                "name": "Yes"
                            },
                            {
                                "value": false,
                                "name": "No"
                            }
                        ],
                        "allowEmpty": false
                    }
                }
            },
            {
                "key": "enableDurability",
                "option": {
                    "label": "Enable Durability",
                    "type": "select",
                    "description": "Enable Durability of the item",
                    "defaultValue": true,
                    "validators": [
                        null
                    ],
                    "props": {
                        "options": [
                            {
                                "value": true,
                                "name": "Yes"
                            },
                            {
                                "value": false,
                                "name": "No"
                            }
                        ],
                        "allowEmpty": false
                    },
                    "hideIf": [
                        [
                            {
                                "key": "modifyDurability",
                                "compare": "NOT_EQUAL",
                                "value": true
                            }
                        ]
                    ]
                }
            },
            {
                "key": "modifyDurabilityCost",
                "option": {
                    "label": "Modify Durability Cost",
                    "type": "select",
                    "description": "Modify Durability Cost of the item",
                    "defaultValue": false,
                    "validators": [
                        null
                    ],
                    "props": {
                        "options": [
                            {
                                "value": true,
                                "name": "Yes"
                            },
                            {
                                "value": false,
                                "name": "No"
                            }
                        ],
                        "allowEmpty": false
                    }
                }
            },
            {
                "key": "durabilityCost",
                "option": {
                    "label": "Durability Cost",
                    "description": "Durability Cost of the item (1000 uses the item after first use)",
                    "type": "numberInput",
                    "defaultValue": 0,
                    "validators": [
                        null
                    ],
                    "props": {
                        "min": 0,
                        "max": 1000,
                        "step": 1,
                        "allowEmpty": false,
                        "useSlider": false
                    },
                    "hideIf": [
                        [
                            {
                                "key": "modifyDurabilityCost",
                                "compare": "NOT_EQUAL",
                                "value": true
                            }
                        ]
                    ]
                }
            },
            {
                "key": "modifyClipSize",
                "option": {
                    "label": "Modify Clip Size",
