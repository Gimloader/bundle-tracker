{
    "id": "luckyBlock",
    "name": "Lucky Block",
    "description": "Grant players something special when they hit this block!",
    "optionSchema": {
        "categories": {
            "categories": [
                {
                    "id": "featured",
                    "name": "Featured"
                },
                {
                    "id": "availability",
                    "name": "Availability"
                },
                {
                    "id": "channels",
                    "name": "Channels"
                }
            ],
            "showAllOptionsAt": "end"
        },
        "options": [
            {
                "key": "whenUsedChannel",
                "option": {
                    "label": "When hit, transmit on",
                    "type": "textInput",
                    "defaultValue": "",
                    "validators": [
                        null
                    ],
                    "props": {
                        "placeholder": "Channel name...",
                        "category": "channel",
                        "maxLength": 100
                    },
                    "description": "When this Lucky Block is hit, the device sends a signal on the selected channel"
                },
                "categories": [
                    "featured",
                    "channels"
                ]
            },
            {
                "key": "activeOnGameStart",
                "option": {
                    "label": "Active On Game Start",
                    "type": "select",
                    "description": "Can this Lucky Block be used when the game starts?",
                    "defaultValue": true,
                    "validators": [
                        null
                    ],
                    "props": {
                        "options": [
                            {
                                "value": true,
                                "name": "Yes"
                            },
                            {
                                "value": false,
                                "name": "No"
                            }
                        ],
                        "allowEmpty": false
                    }
                },
                "categories": [
                    "availability"
                ]
            },
            {
                "key": "activateChannel",
                "option": {
                    "label": "Activate when receiving on",
                    "type": "textInput",
                    "defaultValue": "",
                    "validators": [
                        null
                    ],
                    "props": {
                        "placeholder": "Channel name...",
                        "category": "channel",
                        "maxLength": 100
                    },
                    "description": "Activate this Lucky Block when the device receives a signal from the selected channel"
                },
                "categories": [
                    "availability",
                    "channels"
                ]
            },
            {
                "key": "deactivateChannel",
                "option": {
                    "label": "Deactivate when receiving on",
                    "type": "textInput",
                    "defaultValue": "",
                    "validators": [
                        null
                    ],
                    "props": {
                        "placeholder": "Channel name...",
                        "category": "channel",
                        "maxLength": 100
                    },
                    "description": "Deactivate this Lucky Block when the device receives a signal from the selected channel"
                },
                "categories": [
                    "availability",
                    "channels"
                ]
            },
            {
                "key": "scope",
                "option": {
                    "label": "Active & Recharge Scope",
                    "type": "select",
                    "defaultValue": "global",
                    "validators": [
                        null
                    ],
                    "props": {
                        "options": [
                            {
                                "value": "global",
                                "name": "global"
                            },
                            {
                                "value": "player",
                                "name": "player"
                            },
                            {
                                "value": "team",
                                "name": "team"
                            }
                        ],
                        "allowEmpty": false
                    },
                    "description": "Who shares this Lucky Block’s active state and recharge timer?"
                },
                "categories": [
                    "availability"
                ]
            },
            {
                "key": "rechargeAfterTime",
                "option": {
                    "label": "Recharge Time",
                    "description": "How long (in seconds) does this Lucky Block take to recharge after being used? Set to 0 for no recharge time.",
                    "type": "numberInput",
                    "defaultValue": 3,
                    "validators": [
                        null
                    ],
                    "props": {
                        "min": 0,
                        "max": 1000,
                        "step": 0.1,
                        "allowEmpty": false,
                        "useSlider": false
                    }
                },
                "categories": [
                    "featured"
                ]
            },
            {
                "key": "delayTrigger",
                "option": {
                    "label": "Trigger Delay",
                    "description": "After this Lucky Block is hit, how long (in seconds) does it wait before sending a signal through channels and wires?",
                    "type": "numberInput",
                    "defaultValue": 0,
                    "validators": [
                        null
                    ],
                    "props": {
                        "min": 0,
                        "max": 5,
                        "step": 0.01,
                        "allowEmpty": false,
                        "useSlider": false
                    }
                }
            },
            {
                "key": "scale",
                "option": {
                    "label": "Scale",
                    "type": "numberInput",
                    "defaultValue": 0.7,
                    "validators": [
                        null
                    ],
                    "props": {
                        "min": 0.3,
                        "max": 3,
                        "step": 0.1,
                        "allowEmpty": false,
                        "useSlider": false
                    },
                    "hidden": true
                }
            },
            {
                "key": "showShadow",
                "option": {
                    "label": "Show Shadow",
                    "type": "select",
                    "description": "Is a shadow shown beneath this Lucky Block?",
                    "defaultValue": true,
                    "validators": [
                        null
                    ],
                    "props": {
                        "options": [
                            {
                                "value": true,
                                "name": "Yes"
                            },
                            {
                                "value": false,
                                "name": "No"
                            }
                        ],
                        "allowEmpty": false
                    }
                },
                "supportedMapStyles": [
                    "topDown"
                ]
            }
        ]
    },
    "defaultState": {
        "active": true,
        "charged": true,
        "useCounter": 0
    },
    "codeGridSchema": {
        "allowChannelGrids": false,
        "triggers": [
            {
                "type": "WHEN_TRIGGERED",
                "name": "When hit"
            }
        ],
        "customBlocks": []
    },
    "wireConfig": {
        "out": {
            "connections": [
                {
                    "id": "used",
                    "name": "Block hit"
                }
            ]
        },
        "in": {
            "connections": [
                {
                    "id": "activate",
                    "name": "Activate Lucky Block"
                },
                {
                    "id": "deactivate",
                    "name": "Deactivate Lucky Block"
                }
            ]
        }
    },
    "seasonTicketRequired": true,
    "maxOnMap": 200,
    "initialMemoryCost": 200,
    "subsequentMemoryCost": 200
}