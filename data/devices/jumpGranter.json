{
    "id": "jumpGranter",
    "name": "Jump Crystal",
    "description": "Grant players additional jumps!",
    "optionSchema": {
        "categories": {
            "categories": [
                {
                    "id": "featured",
                    "name": "Featured"
                },
                {
                    "id": "channels",
                    "name": "Channels"
                }
            ],
            "showAllOptionsAt": "end"
        },
        "options": [
            {
                "key": "mode",
                "option": {
                    "label": "Grant Mode",
                    "description": "Specify whether to grant or reset jumps",
                    "type": "select",
                    "validators": [
                        null
                    ],
                    "defaultValue": "grant",
                    "props": {
                        "options": [
                            {
                                "value": "grant",
                                "name": "Grant Jumps"
                            },
                            {
                                "value": "reset",
                                "name": "Reset Jumps"
                            }
                        ],
                        "allowEmpty": false
                    }
                },
                "categories": [
                    "featured"
                ]
            },
            {
                "key": "jumpsNumber",
                "option": {
                    "label": "Jump Count",
                    "description": "The number of jumps to grant",
                    "type": "numberInput",
                    "defaultValue": 1,
                    "validators": [
                        null
                    ],
                    "props": {
                        "min": 1,
                        "max": 10,
                        "allowEmpty": false,
                        "useSlider": false
                    },
                    "hideIf": [
                        [
                            {
                                "key": "mode",
                                "compare": "NOT_EQUAL",
                                "value": "grant"
                            }
                        ]
                    ]
                },
                "categories": [
                    "featured"
                ]
            },
            {
                "key": "disabledTime",
                "option": {
                    "label": "Cooldown Time (Seconds)",
                    "description": "After being used, how long does it take for the Jump Crystal to be usable again?",
                    "type": "numberInput",
                    "defaultValue": 1,
                    "validators": [
                        null
                    ],
                    "props": {
                        "max": 120,
                        "step": 0.1,
                        "allowEmpty": false,
                        "useSlider": false
                    }
                },
                "categories": [
                    "featured"
                ]
            },
            {
                "key": "activeOnStart",
                "option": {
                    "label": "Active On Game Start",
                    "type": "select",
                    "description": "Is the Jump Crystal active when the game starts?",
                    "defaultValue": true,
                    "validators": [
                        null
                    ],
                    "props": {
                        "options": [
                            {
                                "value": true,
                                "name": "Yes"
                            },
                            {
                                "value": false,
                                "name": "No"
                            }
                        ],
                        "allowEmpty": false
                    }
                },
                "categories": [
                    "channels",
                    "featured"
                ]
            },
            {
                "key": "activateOnChannel",
                "option": {
                    "label": "Activate when receiving on",
                    "type": "textInput",
                    "defaultValue": "",
                    "validators": [
                        null
                    ],
                    "props": {
                        "placeholder": "Channel name...",
                        "category": "channel",
                        "maxLength": 100
                    },
                    "description": "Activate when the device receives a signal from the selected channel"
                },
                "categories": [
                    "channels"
                ]
            },
            {
                "key": "deactivateOnChannel",
                "option": {
                    "label": "Deactivate when receiving on",
                    "type": "textInput",
                    "defaultValue": "",
                    "validators": [
                        null
                    ],
                    "props": {
                        "placeholder": "Channel name...",
                        "category": "channel",
                        "maxLength": 100
                    },
                    "description": "Deactivate when the device receives a signal from the selected channel"
                },
                "categories": [
                    "channels"
                ]
            },
            {
                "key": "scope",
                "option": {
                    "label": "Scope",
                    "type": "select",
                    "defaultValue": "player",
                    "validators": [
                        null
                    ],
                    "props": {
                        "options": [
                            {
                                "value": "global",
                                "name": "global"
                            },
                            {
                                "value": "player",
                                "name": "player"
                            },
                            {
                                "value": "team",
                                "name": "team"
                            }
                        ],
                        "allowEmpty": false
                    },
                    "description": "When the Jump Crystal is used or activated/deactivated, who does it apply to?"
                },
                "categories": [
                    "channels"
                ]
            }
        ]
    },
    "defaultState": {
        "active": false,
        "disabled": false
    },
    "codeGridSchema": {
        "allowChannelGrids": false,
        "triggers": [],
        "customBlocks": []
    },
    "wireConfig": {
        "in": {
            "connections": [
                {
                    "id": "activate",
                    "name": "Activate"
                },
                {
                    "id": "deactivate",
                    "name": "Deactivate"
                }
            ]
        }
    },
    "seasonTicketRequired": true,
    "maxOnMap": 256,
    "initialMemoryCost": 50,
    "subsequentMemoryCost": 50,
    "supportedMapStyles": [
        "platformer"
    ]
}